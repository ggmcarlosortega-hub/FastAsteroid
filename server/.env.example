PORT=4000

# Puerto HTTPS adicional para que el navegador pueda conectar el WebSocket
# directo (evita el bloqueo de "mixed content" cuando el frontend es HTTPS).
# Reutiliza los certificados de Fasteroid/certificates si existen; si no
# existen, este listener simplemente no se levanta.
WS_HTTPS_PORT=4443

DB_HOST=localhost
DB_PORT=3306
DB_USER=fasteroid_app
DB_PASSWORD=
DB_NAME=fasteroid

# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
